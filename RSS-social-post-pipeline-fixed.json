    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      title: $json.title ?? $json.name ?? 'Untitled',\n      url: $json.link ?? $json.url ?? '',\n      content: $json.contentSnippet || $json.content || ''\n    }\n  }\n];"
