    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": \"You are a JSON API. Return ONLY a raw JSON object, no markdown, no backticks, no explanation.\\n\\nArticle:\\n{{$json.content}}\\n\\nReturn exactly this structure:\\n{\\\"bullets\\\": [\\\"point1\\\", \\\"point2\\\", \\\"point3\\\"], \\\"tweet\\\": \\\"tweet text here\\\", \\\"linkedin\\\": \\\"linkedin hook here\\\"}\",\n  \"stream\": false,\n  \"format\": \"json\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [624, 0],
      "id": "8a223f35-dd83-4054-a564-ee7ddc9b363e",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "try {\n  let raw = $json.response || '';\n\n  // Find the JSON object within the response\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) throw new Error('No JSON found in response');\n\n  const cleaned = jsonMatch[0]\n    .replace(/\\\\n/g, ' ')\n    .replace(/\\n/g, ' ')\n    .replace(/[\\u201C\\u201D]/g, '\"')\n    .replace(/[\\u2018\\u2019]/g, \"'\")\n    .trim();\n\n  const data = JSON.parse(cleaned);\n\n  const source = $('RSS Feed Trigger').item.json;\n\n  return [{\n    json: {\n      title: source.title ?? source.name ?? 'Untitled',\n      url: source.link ?? source.url ?? '',\n      bullets: Array.isArray(data.bullets) ? data.bullets : [],\n      tweet: data.tweet ?? '',\n      linkedin: data.linkedin ?? ''\n    }\n  }];\n\n} catch (e) {\n  const source = $('RSS Feed Trigger').item.json;\n  return [{\n    json: {\n      title: source.title ?? source.name ?? 'Parse Error',\n      url: source.link ?? source.url ?? '',\n      bullets: ['Error: ' + e.message],\n      tweet: '',\n      linkedin: ''\n    }\n  }];\n}"
      },
